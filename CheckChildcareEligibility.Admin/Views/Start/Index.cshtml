@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Start";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideServiceNavigation = true;
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link-nolink"></a>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">

            <h1 class="govuk-heading-xl">Manage eligibility for childcare support</h1>

            <p>Local authorities can use this service to manage and check eligibility for: </p>
            <ul>
                <li>childcare for working families</li>
                <li>early learning for 2-year-olds </li>
                <li>early years pupil premium </li>
            </ul>

            <p>You can run batch checks and checks for one parent or guardian.</p>


            <a href="/account/sign-in" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
                Sign in
                <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
                </svg>
            </a>

            <h2 class="govuk-heading-m">Before you start</h2>

            <p>You'll need a <a href="https://services.signin.education.gov.uk/">DfE Sign-in account</a> to use this service.  </p>
        </div>

        <div class="govuk-grid-column-one-quarter startPageRightLinkPanel">

            <h2 class="govuk-heading-m govuk-!-margin-top-4">Help and support</h2>

            <p>Use the <a href="https://customerhelpportal.education.gov.uk/">Customer Help Portal</a> to contact us and get help. Visit the <a href="https://khub.net/web/lga/">Knowledge Hub</a> to connect with colleagues at organisations using this service. </p>

            <h2 class="govuk-heading-m">Related content </h2>

            <p><a href="@Configuration["FsmAdminUrl"]">Manage eligibility for free school meals</a></p>

            <p><a href="/Start/UserGuidance"> User guidance: Manage eligibility for childcare support</a></p>
        </div>
    </div>
</div>