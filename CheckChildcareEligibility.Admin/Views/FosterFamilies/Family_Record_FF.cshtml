@using CheckChildcareEligibility.Admin.Boundary.Responses
@model FosterFamilyViewModel
@{
    string carerFullName = @Model.Response.CarerFirstName + " " + @Model.Response.CarerLastName;
    ViewData["Title"] = "Foster family of " + @carerFullName;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("Search", "FosterFamilies")">Back</a>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="error-summary" class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>
                            <p class="govuk-error-message">@errorMessage</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    @if (Model.CarerUpdated || Model.PartnerUpdated || Model.ChildUpdated)
    {
        string message = "Changes to carer saved.";
        if (Model.PartnerUpdated) { message = "Changes to partner saved."; }
        if (Model.ChildUpdated) { message = "Changes to child saved."; }

        <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title"
             data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                    Success
                </h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p>@message</p>
            </div>
        </div>
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

            <a href="@Url.ActionLink("Add_Child_FF", "FosterFamilies", new { Model.Response.FosterCarerId })"
               role="button" draggable="false" class="govuk-button govuk-button" data-module="govuk-button"
               data-govuk-button-init="">
                Add child and create code (**ToDo**)
            </a>
            @if (!Model.Response.HasPartner)
            {
                <a href="@Url.ActionLink("Add_Partner_FF", "FosterFamilies", new { Model.Response.FosterCarerId })"
                   role="button" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                   data-govuk-button-init="">
                    Add partner
                </a>
            }

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Carer
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link"
                               href="@Url.ActionLink("Update_Carer_Details_FF", "FosterFamilies", new { FosterCarerId = Model.Response.FosterCarerId })">Change<span
                                class="govuk-visually-hidden">Carer details</span></a>
                            </li>
                        </ul>
                    </div>
                    <div class="govuk-summary-card__content">
                        <dl class="govuk-summary-list">

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Full name
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.Response.CarerFirstName @Model.Response.CarerLastName
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Date of birth
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.Response.CarerDateOfBirth.ToString("d MMMM yyyy")
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    National Insurance number
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.Response.CarerNationalInsuranceNumber
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                @if (Model.Response.HasPartner == true)
                {
                    <div class="govuk-summary-card">
                        <div class="govuk-summary-card__title-wrapper">
                            <h2 class="govuk-summary-card__title">
                                Partner
                            </h2>
                            <ul class="govuk-summary-card__actions">
                                <li class="govuk-summary-card__action">
                                    <a class="govuk-link" href="@Url.Action("UpdatePartner", "FosterFamilies")">Change
                                        (**ToDo**)<span class="govuk-visually-hidden">Partner details</span></a>
                                    </li>
                                    <li class="govuk-summary-card__action">
                                        <a class="govuk-link" href="@Url.Action("RemovePartner", "FosterFamilies")">Remove
                                            (**ToDo**)<span class="govuk-visually-hidden">Partner details</span></a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="govuk-summary-card__content">
                                    <dl class="govuk-summary-list">

                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">
                                                Full name
                                            </dt>
                                            <dd class="govuk-summary-list__value">
                                                @Model.Response.PartnerFirstName @Model.Response.PartnerLastName
                                            </dd>
                                        </div>

                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">
                                                Date of birth
                                            </dt>
                                            <dd class="govuk-summary-list__value">
                                                @Model.Response.PartnerDateOfBirth?.ToString("d MMMM yyyy")
                                            </dd>
                                        </div>

                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">
                                                National Insurance number
                                            </dt>
                                            <dd class="govuk-summary-list__value">
                                                @Model.Response.PartnerNationalInsuranceNumber
                                            </dd>
                                        </div>
                                    </dl>
                                </div>
                            </div>
                        }

                        <div class="govuk-summary-card">
                            <div class="govuk-summary-card__title-wrapper">
                                <h2 class="govuk-summary-card__title">
                                    Children
                                </h2>
                            </div>
                            <div class="govuk-summary-card__content">
                                <dl class="govuk-summary-list">
                                    @{
                                        var index = 1;
                                    }
                                    @foreach (var child in Model.Response.FosterChildren)
                                    {
                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">
                                                Child @index
                                            </dt>
                                            <dd class="govuk-summary-list__value">
                                                @child.FirstName @child.LastName
                                            </dd>
                                            <dd class="govuk-summary-list__actions">
                                                <a class="govuk-link"
                                                   href="@Url.ActionLink("Code_Record_FF", "FosterFamilies", new { child.FosterChildId })">View<span
                                                    class="govuk-visually-hidden">child details</span></a>
                                                </dd>
                                            </div>
                                            index++;
                                        }
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
