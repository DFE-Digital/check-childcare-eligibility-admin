@using CheckChildcareEligibility.Admin.Boundary.Responses
@using CheckChildcareEligibility.Admin.ViewModels
@model FosterFamilyResponse
@{
    string carerFullName = @Model.CarerFirstName + " " + @Model.CarerLastName;
    ViewData["Title"] = "Foster family of " + @carerFullName;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("Index", "Home")">Back</a>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="error-summary" class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>
                            <p class="govuk-error-message">@errorMessage</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

            <a href="/childcare/dev/foster/add-child/child-details" role="button" draggable="false" class="govuk-button govuk-button" data-module="govuk-button" data-govuk-button-init="">
                Add child and create code
            </a>

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Carer
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.ActionLink("UpdateCarer", "FosterFamilies", new { Model.FosterCarerId, ClearData = false, includeChildren = true })">Change<span class="govuk-visually-hidden">Carer details</span></a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Full name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.CarerFirstName @Model.CarerLastName
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Date of birth
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.CarerDateOfBirth.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                National Insurance number
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.CarerNationalInsuranceNumber
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            @if (Model.HasPartner == true)
            {
                <div class="govuk-summary-card">
                    <div class="govuk-summary-card__title-wrapper">
                        <h2 class="govuk-summary-card__title">
                            Partner
                        </h2>
                        <ul class="govuk-summary-card__actions">
                            <li class="govuk-summary-card__action">
                                <a class="govuk-link" href="@Url.Action("UpdatePartner", "FosterFamilies")">Change<span class="govuk-visually-hidden">Partner details</span></a>
                            </li>
                            <li class="govuk-summary-card__action">
                                <a class="govuk-link" href="@Url.Action("RemovePartner", "FosterFamilies")">Remove<span class="govuk-visually-hidden">Partner details</span></a>
                            </li>
                        </ul>
                    </div>
                    <div class="govuk-summary-card__content">
                        <dl class="govuk-summary-list">

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Full name
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.PartnerFirstName @Model.PartnerLastName
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Date of birth
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.PartnerDateOfBirth?.ToString("d MMMM yyyy")
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    National Insurance number
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.PartnerNationalInsuranceNumber
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            }

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Children
                    </h2>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">
                        @{
                            var index = 1;
                        }
                        @foreach (var child in Model.FosterChildren)
                        {
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Child @index
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @child.FirstName @child.LastName
                                </dd>
                                <dd class="govuk-summary-list__actions">
                                    <a class="govuk-link" href="#">View<span class="govuk-visually-hidden">child @index</span></a>
                                </dd>
                            </div>
                            index++;
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
