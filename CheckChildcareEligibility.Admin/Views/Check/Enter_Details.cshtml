@model ParentGuardian

@{
    ViewData["Title"] = "Run a check for one parent or guardian";

    var eligibilityType = TempData.Peek("eligibilityType")?.ToString() ?? string.Empty;
    bool isEypp = string.Equals(eligibilityType, "EYPP", StringComparison.OrdinalIgnoreCase);
    ViewData["IsEypp"] = isEypp;
}

<div class="govuk-grid-column-two-thirds">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("MenuSingleCheck", "Home")">Back</a>

    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ValidationSummary" model="ViewData.ModelState" />
    }

    <span class="govuk-caption-l">@TempData["eligibilityTypeLabel"]</span>
    <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    <p class="govuk-body">Enter the details of the parent or guardian to check eligibility for @TempData["eligibilityTypeLabel"].</p>

    <form asp-controller="Check" asp-action="Enter_Details" method="post">
        <input type="hidden" name="eligibilityType" value="@eligibilityType" />
        <fieldset class="govuk-fieldset">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="LastName">
                    Last name in full
                </label>
                <p class="govuk-error-message">
                    <span asp-validation-for="LastName"></span>
                </p>
                <input class="govuk-input govuk-input--width-20 @(ViewData.ModelState["LastName"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                       asp-for="LastName" type="text" aria-label="Last name in full">
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="dob-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Date of birth
                    </legend>

                    <div id="dob-hint" class="govuk-hint">
                        For example, 31 3 1980
                    </div>

                    <p class="govuk-error-message">
                        <span asp-validation-for="DateOfBirth" class="govuk-error-message"></span>
                    </p>

                    <div class="govuk-date-input" id="DateOfBirth">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Day">
                                    Day
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState["DateOfBirth.Day"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Day" id="DateOfBirth.Day" type="text" inputmode="numeric" maxlength="2" />
                            </div>
                        </div>

                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Month">
                                    Month
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2 @(ViewData.ModelState["DateOfBirth.Month"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Month" id="DateOfBirth.Month" type="text" inputmode="numeric" maxlength="2" />
                            </div>
                        </div>

                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="DateOfBirth.Year">
                                    Year
                                </label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-4 @(ViewData.ModelState["DateOfBirth.Year"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                                       asp-for="Year" id="DateOfBirth.Year" type="text" inputmode="numeric" maxlength="4" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <partial name="_IdentifierFieldsPartial" model="Model" />
        </fieldset>

        <button class="govuk-button govuk-!-margin-top-5" data-module="govuk-button">
            Run check
        </button>
    </form>
    @if (isEypp)
    {
        <p class="govuk-body"><a class="govuk-link" rel="noreferrer noopener" target="_blank" href="@TempData["GuidanceLink"]">Parent or guardian is an asylum seeker (opens in new tab)</a></p>
    }
    else if (eligibilityType == "2YO")
    {
        <p class="govuk-body"><a class="govuk-link" rel="noreferrer noopener" target="_blank" href="https://www.gov.uk/government/publications/early-years-entitlements-for-foster-children-and-nrpf-families/early-learning-for-2-year-olds-for-families-with-no-recourse-to-public-funds-assessing-eligibility">Parent or guardian has no recourse to public funds (NRPF)</a></p>
    }
</div>

<script src="/js/validationSummary.js"></script>