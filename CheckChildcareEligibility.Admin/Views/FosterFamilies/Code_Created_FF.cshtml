@using CheckChildcareEligibility.Admin.Domain.Enums.WorkingFamilies
@using CheckChildcareEligibility.Admin.Helpers
@using CheckChildcareEligibility.Admin.ViewModels
@model FosterFamilyCreatedViewModel
@{
    ViewData["Title"] = "Family added and code created";
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("CheckDetails", "FosterFamilies")">Back</a>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <div class="govuk-panel govuk-panel--confirmation">
                <h1 class="govuk-panel__title">
                    @ViewData["Title"]
                </h1>
                <div class="govuk-panel__body">
                    Eligibility code <br> <strong>@Model.Response.EligibilityCode</strong>
                </div>
            </div>

            <p class="govuk-!-margin-top-6">Send the eligibility code to the social worker. The foster family will need to  give the code to the childcare provider.</p>

            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-table__caption--m"></caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Child name</th>
                        <th scope="col" class="govuk-table__header">Eligibility code</th>
                        <th scope="col" class="govuk-table__header">Code status</th>
                        <th scope="col" class="govuk-table__header">Eligibility confirmed on</th>
                        <th scope="col" class="govuk-table__header">Reconfirm between</th>
                        <th scope="col" class="govuk-table__header">Grace period ends</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@Model.Response.ChildFullName</td>
                        <td class="govuk-table__cell">@Model.Response.EligibilityCode</td>
                        <td class="govuk-table__cell">Valid from @Model.ValidFromTerm.Name.ToString().ToLower() term @Model.ValidFromTerm.StartDate.Year</td>
                        <td class="govuk-table__cell">@Model.Response.ValidityStartDate.ToString("d MMMM yyyy")</td>
                        <td class="govuk-table__cell">@WorkingFamiliesCheckHelper.GetReconfirmBetween(EligibilityCodeType.Foster, Model.Response.ReconfirmationProperties)</td>
                        <td class="govuk-table__cell">@Model.Response.GracePeriodEndDate.ToString("d MMMM yyyy")</td>
                    </tr>
                </tbody>
            </table>
            
            <a href="@Url.Action("Code_Record_FF", "FosterFamilies", new { Model.Response.FosterChildId })" role="button" draggable="false" class="govuk-button" data-module="govuk-button" data-govuk-button-init=""">
                View code details
            </a>
        </div>
    </div>
</div>
