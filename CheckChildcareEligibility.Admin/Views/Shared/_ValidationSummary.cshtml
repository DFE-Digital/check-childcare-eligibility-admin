@using CheckChildcareEligibility.Admin.ViewModels
@model Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary

@{
    ViewData["Title"] = "There is a problem";

@functions {
    public class ValidationError
    {
        public string Field { get; set; }
        public string OriginalField { get; set; }
        public string Error { get; set; }
    }
}

// Get all the errors
var errors = new List<ValidationError>();
foreach (var m in Model)
{
    foreach (var e in m.Value.Errors)
    {
        var originalField = m.Key;
        var field = originalField;

        // Remap School.URN to School so the error summary links correctly
        if (originalField.EndsWith("School.URN"))
        {
            field = originalField.Replace("School.URN", "School");
        }
        if (originalField.Equals("IsTodaySelected"))
        {
            field = originalField.Replace("IsTodaySelected", "submission-date-radios-Today");
        }
        if (originalField.StartsWith("SubmissionDate"))
        {
            field = "submission-date-radios-Today";
        }
        errors.Add(new ValidationError
        {
            Field = field,
            OriginalField = originalField,
            Error = e.ErrorMessage
        });
    }
}

// Get DOB or Date errors - need to handle separately as multi-field input -> single field output
var dateErrors = new List<ValidationError>();
foreach (var error in errors)
{
    if (error.OriginalField.EndsWith("Day") ||
        error.OriginalField.EndsWith("Month") ||
        error.OriginalField.EndsWith("Year") ||
        error.OriginalField.EndsWith("DateOfBirth") ||
        error.OriginalField.EndsWith("SubmissionDate"))
    {
        dateErrors.Add(error);
    }
}

// Only keep the highest-priority DOB or Date error (the one we will report)
string[] datePriority = dateErrors.Any(e => e.OriginalField.EndsWith("SubmissionDate"))
    ? new[] { "Day", "Month", "Year", "SubmissionDate" }
    : new[] { "Day", "Month", "Year", "DateOfBirth" };
ValidationError selectedDateError = null;
foreach (var priority in datePriority)
{
    foreach (var e in dateErrors)
    {
        if (e.OriginalField.EndsWith(priority))
        {
            selectedDateError = e;
            break;
        }
    }
    if (selectedDateError != null)
        break;
}

// Get non-DOB/Date errors
var nonDateErrors = new List<ValidationError>();
foreach (var error in errors)
{
    if (!dateErrors.Contains(error))
    {
        nonDateErrors.Add(error);
    }
}

var finalErrors = nonDateErrors.ToList();
if (selectedDateError != null)
{
    finalErrors.Add(selectedDateError);
}

// Order the errors
List<string> propertyOrder = new List<string>();

if (Model.ContainsKey("CarerLastName")) //fosterCarer
{
    propertyOrder = new List<string>
        {
            "CarerFirstName",
            "CarerLastName",
            "CarerDateOfBirth",
            "CarerDateOfBirth.Day",
            "CarerDateOfBirth.Month",
            "CarerDateOfBirth.Year",
            "CarerNationalInsuranceNumber",
            "HasPartner",
        };
}
if (Model.ContainsKey("PartnerLastName")) //fosterPartner
{
    propertyOrder = new List<string>
        {
            "PartnerFirstName",
            "PartnerLastName",
            "PartnerDateOfBirth",
            "PartnerDateOfBirth.Day",
            "PartnerDateOfBirth.Month",
            "PartnerDateOfBirth.Year",
            "PartnerNationalInsuranceNumber",
        };
}
if (Model.ContainsKey("ChildPostCode")) //fosterChild
{
    propertyOrder = new List<string>
        {
            "ChildFirstName",
            "ChildLastName",
            "ChildDateOfBirth",
            "ChildDateOfBirth.Day",
            "ChildDateOfBirth.Month",
            "ChildDateOfBirth.Year",
            "ChildPostCode",
        };
}
else if (Model.ContainsKey("LastName")) //Parent
{
    foreach (var prop in typeof(ParentGuardian).GetProperties())
    {
        propertyOrder.Add(prop.Name);
    }
    UpdateDateFields(propertyOrder);
}
else if (Model.ContainsKey("EligibilityCode") || Model.ContainsKey("Child.EligibilityCode")) //ParentAndChild
{
    propertyOrder = new List<string>
        {
            "Child.EligibilityCode",
            "NationalInsuranceNumber",
            "Child.ChildDateOfBirth",
            "Child.ChildDateOfBirth.Day",
            "Child.ChildDateOfBirth.Month",
            "Child.ChildDateOfBirth.Year"
        };
    // UpdateDateFields(propertyOrder);
}

void UpdateDateFields(List<string> propertyOrder)
{
    int index;

    index = propertyOrder.IndexOf("Day");
    if (index != -1) propertyOrder[index] = "DateOfBirth.Day";

    index = propertyOrder.IndexOf("Month");
    if (index != -1) propertyOrder[index] = "DateOfBirth.Month";

    index = propertyOrder.IndexOf("Year");
    if (index != -1) propertyOrder[index] = "DateOfBirth.Year";
}

string[] fieldOrder = propertyOrder.ToArray();
errors = finalErrors
    .OrderBy(e =>
    {
        int index = Array.IndexOf(fieldOrder, e.Field);
        return index == -1 ? int.MaxValue : index; // Put unknown fields at the end
    })
    .ToList();

//Only way I can get Viewmodel error for DOB or Date to show inline
TempData["DateError"] = string.Empty;
if (selectedDateError != null && selectedDateError.OriginalField.StartsWith("Child.ChildDateOfBirth")
    || selectedDateError != null && selectedDateError.OriginalField.StartsWith("CarerDateOfBirth")
    || selectedDateError != null && selectedDateError.OriginalField.StartsWith("PartnerDateOfBirth")
    || selectedDateError != null && selectedDateError.OriginalField.StartsWith("ChildDateOfBirth")
    || selectedDateError != null && selectedDateError.OriginalField.StartsWith("SubmissionDate"))
{
    TempData["DateError"] = selectedDateError.Error;
}
}

<div id="error-summary" class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
                @foreach (var modelError in errors)
                {
                    <li>
                        @if (string.IsNullOrEmpty(modelError.Field))
                        {
                            @modelError.Error
                        }
                        else
                        {
                            <a class="govuk-error-message" href="#@modelError.Field">@modelError.Error</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
