@using CheckChildcareEligibility.Admin.Domain.Enums.WorkingFamilies
@using CheckChildcareEligibility.Admin.Helpers
@using CheckChildcareEligibility.Admin.ViewModels
@model FosterCodeReconfirmedViewModel
@{
    ViewData["Title"] = "Code reconfirmed";
}

<div class="govuk-grid-column-full">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <div class="govuk-panel govuk-panel--confirmation">
                <h1 class="govuk-panel__title">
                    @ViewData["Title"]
                </h1>
                <div class="govuk-panel__body">
                    Eligibility code <br> <strong>@Model.Response.EligibilityCode</strong>
                </div>
            </div>

            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-table__caption--m"></caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Child name</th>
                        <th scope="col" class="govuk-table__header">Eligibility code</th>
                        <th scope="col" class="govuk-table__header">Code status</th>
                        <th scope="col" class="govuk-table__header">Reconfirm between</th>
                        <th scope="col" class="govuk-table__header">@Model.CodeProperties.GracePeriodEndLabel</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@Model.Response.ChildFirstName @Model.Response.ChildLastName</td>
                        <td class="govuk-table__cell">@Model.Response.EligibilityCode</td>
                        <td class="govuk-table__cell">@Model.CodeStatus</td>
                        <td class="govuk-table__cell">@WorkingFamiliesCheckHelper.GetReconfirmBetween(EligibilityCodeType.Foster, Model.Response.ReconfirmationProperties)</td>
                        <td class="govuk-table__cell">@Model.CodeProperties.GracePeriodEndDisplay</td>
                    </tr>
                </tbody>
            </table>
            
            <a href="@Url.Action("Code_Record_FF", "FosterFamilies", new { Model.Response.FosterChildId })" role="button" draggable="false" class="govuk-button" data-module="govuk-button" data-govuk-button-init="">
                View code details
            </a>
        </div>
    </div>
</div>
