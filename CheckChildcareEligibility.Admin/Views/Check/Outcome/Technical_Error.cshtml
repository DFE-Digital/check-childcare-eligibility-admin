@{
    ViewData["Title"] = "Check failed";
    string correlationID = ViewData["CorrelationID"]?.ToString();
    string errorCode = ViewData["ErrorCode"]?.ToString();
}

@inject IConfiguration Configuration

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" @Html.ActionLink("Back", "MenuSingleCheck", "Home")></a>

    <div id="content" data-type="Technical_Error" class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title"
                 data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h1 class="govuk-notification-banner__title"
                        id="govuk-notification-banner-title">@ViewData["Title"]</h1>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">There's been a technical error.</p>
                    <p>
                        @Html.ActionLink("Try again later", "Enter_Details", "Check", new { clearData = true }, null), ensuring you've entered the parent
                        or guardian details accurately.</p>
                </div>
            </div>

            <h2 class="govuk-heading-l">Parent or guardian details</h2>

            <div class="govuk-body">
                <dl class="govuk-summary-list">

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Last Name
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @Model.ParentLastName
                        </dd>
                    </div>

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Date of birth
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @DateTime.Parse(Model.ParentDateOfBirth).ToString("d MMMM yyyy")
                        </dd>
                    </div>

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            National Insurance number
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @Model.ParentNino
                        </dd>
                    </div>
                </dl>
            </div>

            <h2>How to report this error</h2>
            <p>Copy the following details and send them to our team using the <a target="_blank" href="https://customerhelpportal.education.gov.uk/">Customer Help Portal</a>.</p>
            @if (!string.IsNullOrEmpty(correlationID))
            {
                <p>Correlation ID: @correlationID</p>
            }
            <p>Error code: @errorCode</p>
            <p>Please copy and paste the details rather than sending a screenshot.</p>

            <h2 class="govuk-heading-l">If the check keeps failing</h2>
            <p class="govuk-body"> 
                Contact the <a href="@Configuration["ContactUsUrl"]"> Department for Education Customer Help Portal</a>.
            </p>
        </div>
    </div>
</div>