@using CheckChildcareEligibility.Admin.Domain.Enums.WorkingFamilies
@using CheckChildcareEligibility.Admin.Helpers
@using CheckChildcareEligibility.Admin.ViewModels
@model CheckChildcareEligibility.Admin.ViewModels.SearchFosterFamiliesRecordsViewModel
@{
    ViewData["Title"] = "Manage foster families";
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("Index", "Home")">Back</a>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
            <p>Manage foster families claiming Childcare for working families.</p>

            @Html.ActionLink("Add foster family", actionName: "EnterCarer", "FosterFamilies", null, new { @class = "govuk-button govuk-!-margin-bottom-9" })

            <h2 class="govuk-heading-m">Children and eligibility codes</h2>
            @if (Model.Data != null && Model.Data.Any())
            {
                <table class="govuk-table govuk-table--small-text-until-tablet">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Child name</th>
                            <th scope="col" class="govuk-table__header">Child date of birth</th>
                            <th scope="col" class="govuk-table__header">Eligibility code</th>
                            <th scope="col" class="govuk-table__header">Carer name</th>
                            <th scope="col" class="govuk-table__header">Eligibility confirmed on</th>
                            <th scope="col" class="govuk-table__header">Reconfirm between</th>
                            <th scope="col" class="govuk-table__header">Grace period ends</th>
                            <th scope="col" class="govuk-table__header">Reconfirmation status</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var item in Model.Data)
                        {
                            string[] reconfirmationStatus = WorkingFamiliesCheckHelper.GetReconfirmStatus(item.ReconfirmationProperties);
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">@Html.ActionLink(item.ChildName, "Code_Record_FF", "FosterFamilies", new { FosterChildId = item.FosterChildId }, new { @class = "govuk-link" })</td>
                                <td class="govuk-table__cell">@item.ChildDateOfBirth.ToString("d MMMM yyyy")</td>
                                <td class="govuk-table__cell">@item.EligibilityCode</td>
                                <td class="govuk-table__cell">@Html.ActionLink(item.CarerName, "Family_Record_FF", "FosterFamilies", new { FosterCarerId = item.FosterCarerId }, new { @class = "govuk-link" })</td>
                                <td class="govuk-table__cell">@item.ValidityStartDate.ToString(format: "d MMMM yyyy")</td>
                                <td class="govuk-table__cell">@WorkingFamiliesCheckHelper.GetReconfirmBetween(EligibilityCodeType.Foster, item.ReconfirmationProperties)</td>
                                <td class="govuk-table__cell">@item.GracePeriodEndDate.ToString("d MMMM yyyy")</td>
                                <td class="govuk-table__cell">
                                    <strong class="govuk-tag govuk-tag--@reconfirmationStatus[1]" style="max-width:100%;">
                                        @reconfirmationStatus[0]
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No results found.</p>
            }

            @{
                var paginationModel = new PaginationPartialViewModel
                {
                    CurrentPage = Model.PageNumber,
                    TotalPages = (int)Math.Ceiling((double)Model.TotalNumberOfRecords / Model.PageSize),
                    RecordsPerPage = Model.PageSize,
                    TotalRecords = Model.TotalNumberOfRecords,
                    ControllerName = "FosterFamilies"
                };

                @if (paginationModel.TotalPages > 1)
                {
                    <partial name="PaginationPartial" model="paginationModel" />
                }
            }
            @if (Model.Data == null)
            {
                <p class="govuk-!-margin-bottom-6"><a href="/public/csv/childcare/dev/foster-families-codes-YYYY-MM-DD.csv">Download as CSV file</a></p>
            }
        </div>
    </div>
</div>