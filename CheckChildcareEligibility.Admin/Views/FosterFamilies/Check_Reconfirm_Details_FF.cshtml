@using CheckChildcareEligibility.Admin.ViewModels
@model FosterCodeReconfirmCheckDetailsViewModel
@{
    ViewData["Title"] = "Check details";
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS"
       href="@Url.Action("Enter_Reconfirm_Date_Details_FF", "FosterFamilies", new { Model.FosterChildId })">Back
    </a>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="error-summary" class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>
                            <p class="govuk-error-message">@errorMessage</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Child
                    </h2>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Full name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.ChildFullName
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Eligibility code dates
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link"
                               href="@Url.Action("Enter_Reconfirm_Date_FF", "FosterFamilies", new { Model.FosterChildId })">Change<span
                                class="govuk-visually-hidden">Eligibility code date</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Eligibility confirmed on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ValidityStartDate.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Code valid from
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ValidFromTerm.Name term @Model.FosterCodePreview.ValidFromTerm.StartDate.Year
                                (starts @Model.FosterCodePreview.ValidFromTerm.StartDate.ToString("d MMMM yyyy"))
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Reconfirm between
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ReconfirmBetweenStart.ToString("d MMMM yyyy")
                                and @Model.FosterCodePreview.ReconfirmBetweenEnd.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Grace period ends
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.GracePeriodEndDate.ToString("d MMMM yyyy")
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <h2 class="govuk-heading-m">Reconfirm this is consistent with a care plan</h2>

            <p class="govuk-body">By submitting this information, you confirm you have worked with the designated person
                (for example, a social worker) to establish that:
            </p>
            <ul class="govuk-list govuk-list--bullet">
                <li>the foster carer works outside of their foster role</li>
                <li>providing an eligibility code is consistent with the child's care plan</li>
            </ul>

            <form asp-controller="FosterFamilies" asp-action="CheckReconfirmDetails" method="post">
                <input asp-for="FosterChildId" type="hidden" />
                <input type="hidden" asp-for="FosterCodeReconfirmDateViewModel.SubmissionDate" />
                
                <button type="submit" class="govuk-button govuk-!-margin-top-5" data-module="govuk-button">
                    Reconfirm code
                </button>
            </form>
        </div>
    </div>
</div>
