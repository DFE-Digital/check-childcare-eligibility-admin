@using CheckChildcareEligibility.Admin.ViewModels
@model FosterApplicationCheckDetailsViewModel
@{
    ViewData["Title"] = "Check details";
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="govuk-grid-column-full">
    <a class="govuk-back-link backLinkJS" href="@Url.Action("Enter_Submitted_Date_Details_FF", "FosterFamilies", new { Model.ContextId} )">Back</a>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="error-summary" class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>
                            <p class="govuk-error-message">@errorMessage</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Carer
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link"
                               href="@Url.Action("Enter_Carer_Details_FF", "FosterFamilies", new { Model.ContextId })">Change
                                <span class="govuk-visually-hidden">Carer details</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Full name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCarerDetailsViewModel.CarerFirstName
                                @Model.FosterCarerDetailsViewModel.CarerLastName
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Date of birth
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @DateTime.Parse(Model.FosterCarerDetailsViewModel.CarerDateOfBirth.ToString()).ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                National Insurance number
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCarerDetailsViewModel.CarerNationalInsuranceNumber
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            @if (Model.FosterCarerDetailsViewModel.HasPartner == true)
            {
                <div class="govuk-summary-card">
                    <div class="govuk-summary-card__title-wrapper">
                        <h2 class="govuk-summary-card__title">
                            Partner
                        </h2>
                        <ul class="govuk-summary-card__actions">
                            <li class="govuk-summary-card__action">
                                <a class="govuk-link"
                                   href="@Url.Action("Enter_Partner_Details_FF", "FosterFamilies", new { Model.ContextId })">Change
                                    <span class="govuk-visually-hidden">Partner details</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="govuk-summary-card__content">
                        <dl class="govuk-summary-list">
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Full name
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.FosterPartnerDetailsViewModel.PartnerFirstName
                                    @Model.FosterPartnerDetailsViewModel.PartnerLastName
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    Date of birth
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @DateTime.Parse(Model.FosterPartnerDetailsViewModel.PartnerDateOfBirth.ToString()).ToString("d MMMM yyyy")
                                </dd>
                            </div>

                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    National Insurance number
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @Model.FosterPartnerDetailsViewModel.PartnerNationalInsuranceNumber
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            }

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Child
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link"
                               href="@Url.Action("Enter_Child_Details_FF", "FosterFamilies", new { Model.ContextId })">Change<span
                                class="govuk-visually-hidden">Child details</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Full name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterChildDetailsViewModel.ChildFirstName
                                @Model.FosterChildDetailsViewModel.ChildLastName
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Date of birth
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @DateTime.Parse(Model.FosterChildDetailsViewModel.ChildDateOfBirth.ToString()).ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Postcode
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterChildDetailsViewModel.ChildPostCode
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        Eligibility code dates
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link"
                               href="@Url.Action("Enter_Submitted_Date_Details_FF", "FosterFamilies", new { Model.ContextId })">Change<span
                                class="govuk-visually-hidden">Eligibility code date</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Application submitted on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterApplicationSubmittedDateViewModel.SubmissionDate.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Eligibility confirmed on
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ValidityStartDate.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Code valid from
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ValidFromTerm.Name
                                @Model.FosterCodePreview.ValidFromTerm.StartDate.Year
                                (starts @Model.FosterCodePreview.ValidFromTerm.StartDate.ToString("d MMMM yyyy"))
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Reconfirm between
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.ReconfirmBetweenStart.ToString("d MMMM yyyy")
                                and @Model.FosterCodePreview.ReconfirmBetweenEnd.ToString("d MMMM yyyy")
                            </dd>
                        </div>

                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Grace period ends
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @Model.FosterCodePreview.GracePeriodEndDate.ToString("d MMMM yyyy")
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <h2 class="govuk-heading-m">Confirm this is consistent with a care plan</h2>

            <p class="govuk-body">By submitting this information, you confirm you have worked with the designated person
                (for example, a social worker) to establish that:
        </p>
            <ul class="govuk-list govuk-list--bullet">
                <li>the foster carer works outside of their foster role</li>
                <li>providing an eligibility code is consistent with the child's care plan</li>
            </ul>

            <form asp-controller="FosterFamilies" asp-action="CheckDetails" method="post">
                <input asp-for="FosterCarerDetailsViewModel.ContextId" type="hidden" />
                <!-- Carer Details -->
                <input type="hidden" asp-for="FosterCarerDetailsViewModel.CarerFirstName" />
                <input type="hidden" asp-for="FosterCarerDetailsViewModel.CarerLastName" />
                <input type="hidden" asp-for="FosterCarerDetailsViewModel.CarerDateOfBirth" />
                <input type="hidden" asp-for="FosterCarerDetailsViewModel.CarerNationalInsuranceNumber" />
                <input type="hidden" asp-for="FosterCarerDetailsViewModel.HasPartner" />
                <!-- Partner Details -->
                @if (Model.FosterPartnerDetailsViewModel != null)
                {
                    <input type="hidden" asp-for="FosterPartnerDetailsViewModel.PartnerFirstName" />
                    <input type="hidden" asp-for="FosterPartnerDetailsViewModel.PartnerLastName" />
                    <input type="hidden" asp-for="FosterPartnerDetailsViewModel.PartnerDateOfBirth" />
                    <input type="hidden" asp-for="FosterPartnerDetailsViewModel.PartnerNationalInsuranceNumber" />
                }
                <!-- Child details -->
                <input type="hidden" asp-for="FosterChildDetailsViewModel.ChildFirstName" />
                <input type="hidden" asp-for="FosterChildDetailsViewModel.ChildLastName" />
                <input type="hidden" asp-for="FosterChildDetailsViewModel.ChildDateOfBirth" />
                <input type="hidden" asp-for="FosterChildDetailsViewModel.ChildPostCode" />
                <!-- Application submitted date -->
                <input type="hidden" asp-for="FosterApplicationSubmittedDateViewModel.SubmissionDate" />

                <button type="submit" class="govuk-button govuk-!-margin-top-5" data-module="govuk-button">
                    Add foster family
                </button>
            </form>
        </div>
    </div>
</div>
